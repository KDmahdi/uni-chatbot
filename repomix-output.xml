  transition: background-color 0.25s ease, color 0.25s ease;
}

/* Dark Theme Variables - Triggered by [data-theme="dark"] on html, body, or wrapper */
:global([data-theme="dark"]) .pageWrapper,
.pageWrapper[data-theme="dark"] {
