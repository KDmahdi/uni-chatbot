  --success-text: #065f46;

  --danger-primary: #dc2626;
  --danger-hover: #b91c1c;
  --danger-bg: #fef2f2;
  --danger-border: #fecaca;
  --danger-text: #991b1b;

  --info-bg: #eff6ff;
