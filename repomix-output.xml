  border-radius: var(--radius-lg);
  padding: 1.35rem 1.25rem;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.statCard:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.statIconWrapper {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.statIconWrapper[data-accent="blue"] {
  background-color: rgba(59, 130, 246, 0.14);
  color: #3b82f6;
}

.statIconWrapper[data-accent="purple"] {
  background-color: rgba(168, 85, 247, 0.14);
  color: #a855f7;
}

.statIconWrapper[data-accent="emerald"] {
  background-color: rgba(16, 185, 129, 0.14);
  color: #10b981;
}

.statIconWrapper[data-accent="amber"] {
  background-color: rgba(245, 158, 11, 0.14);
  color: #f59e0b;
}

.statContent {
  display: flex;
  flex-direction: column;
}

.statLabel {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
}

.statValue {
  font-size: 1.75rem;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.3;
  margin: 0.15rem 0;
}

.statMeta {
  font-size: 0.76rem;
  color: var(--text-muted);
}

/* ==========================================================================
   2. Upload Zone & 5. Actions Panel
   ========================================================================== */

.managementGrid {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 1.25rem;
}

.uploadCard,
.actionsCard {
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.sectionHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.15rem;
  flex-wrap: wrap;
}

.sectionTitle {
  font-size: 1.05rem;
  font-weight: 700;
  margin: 0;
  color: var(--text-primary);
}

.sectionDesc {
  font-size: 0.84rem;
  color: var(--text-muted);
  margin: 0.25rem 0 0 0;
}

.sectionDesc code {
  background-color: var(--bg-tertiary);
  padding: 0.1rem 0.4rem;
  border-radius: 4px;
  font-family: monospace;
}

.sampleDataBtn {
  background-color: var(--accent-soft);
  color: var(--accent-primary);
  border: 1px solid transparent;
  padding: 0.45rem 0.85rem;
  border-radius: var(--radius-sm);
  font-family: inherit;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.sampleDataBtn:hover {
  background-color: var(--accent-primary);
  color: #ffffff;
}

.dropZone {
  border: 2px dashed var(--border-strong);
  border-radius: var(--radius-md);
  background-color: var(--bg-primary);
  padding: 2.25rem 1.5rem;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
}

.dropZone:hover,
.dropZoneActive {
  border-color: var(--accent-primary);
  background-color: var(--accent-soft);
}

.hiddenFileInput {
  display: none;
}

.dropZoneIcon {
  font-size: 2.2rem;
  line-height: 1;
}

.dropZoneTitle {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
}

.dropZoneTitle code {
  color: var(--accent-primary);
  font-family: monospace;
}

.dropZoneHint {
  font-size: 0.78rem;
  color: var(--text-muted);
  max-width: 520px;
}

.actionsCard {
  gap: 1.25rem;
}

.actionBlock {
  padding-bottom: 1.25rem;
  border-bottom: 1px solid var(--border-subtle);
}

.actionBlockTitle {
  font-size: 0.98rem;
  font-weight: 700;
  margin: 0 0 0.35rem 0;
  color: var(--text-primary);
}

.actionBlockDesc {
  font-size: 0.82rem;
  color: var(--text-muted);
  margin: 0 0 0.95rem 0;
}

.exportActionBtn {
  width: 100%;
  padding: 0.75rem 1rem;
  border-radius: var(--radius-sm);
  border: none;
  background-color: var(--accent-primary);
  color: #ffffff;
  font-family: inherit;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.exportActionBtn:hover:not(:disabled) {
  background-color: var(--accent-primary-hover);
}

.exportActionBtn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.dangerZoneBlock {
  background-color: var(--danger-bg);
  border: 1px solid var(--danger-border);
  border-radius: var(--radius-md);
  padding: 1.1rem;
}

.dangerHeader {
  margin-bottom: 0.4rem;
}

.dangerBadge {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--danger-text);
  background-color: rgba(220, 38, 38, 0.15);
  padding: 0.15rem 0.55rem;
  border-radius: 999px;
}

.dangerTitle {
  font-size: 0.94rem;
  font-weight: 700;
  color: var(--danger-text);
  margin: 0 0 0.3rem 0;
}

.dangerDesc {
  font-size: 0.8rem;
  color: var(--danger-text);
  opacity: 0.9;
  margin: 0 0 0.9rem 0;
}

.dangerResetBtn {
  width: 100%;
  padding: 0.7rem 1rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--danger-border);
  background-color: var(--danger-primary);
  color: #ffffff;
  font-family: inherit;
  font-size: 0.86rem;
  font-weight: 700;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.dangerResetBtn:hover:not(:disabled) {
  background-color: var(--danger-hover);
}

.dangerResetBtn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* ==========================================================================
   4. Courses Data Table & Search Bar
   ========================================================================== */

.tableCard {
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.tableToolbar {
  padding: 1.35rem 1.5rem;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.tableToolbarTitleBox {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.FilterCountBadge {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--accent-primary);
  background-color: var(--accent-soft);
  padding: 0.3rem 0.8rem;
  border-radius: 999px;
}

.filtersRow {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 0.9rem;
}

.searchWrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.searchIcon {
  position: absolute;
  right: 0.9rem;
  font-size: 0.95rem;
  pointer-events: none;
}

.searchInput {
  width: 100%;
  padding: 0.7rem 2.45rem 0.7rem 2.2rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-strong);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.88rem;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.searchInput:focus {
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

.clearSearchBtn {
  position: absolute;
  left: 0.65rem;
  background: transparent;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 0.88rem;
  padding: 0.2rem 0.4rem;
}

.clearSearchBtn:hover {
  color: var(--text-primary);
}

.selectWrapper {
  width: 100%;
}

.departmentSelect {
  width: 100%;
  padding: 0.7rem 0.9rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-strong);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.88rem;
  outline: none;
  cursor: pointer;
}

.departmentSelect:focus {
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

/* Table Scroll & Styling */

.tableScrollContainer {
  width: 100%;
  overflow-x: auto;
}

.coursesTable {
  width: 100%;
  border-collapse: collapse;
  min-width: 980px;
}

.coursesTable thead tr {
  background-color: var(--bg-tertiary);
  border-bottom: 1px solid var(--border-strong);
}

.coursesTable th {
  padding: 0.9rem 1rem;
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--text-secondary);
  text-align: right;
  white-space: nowrap;
}

.coursesTable tbody tr {
  border-bottom: 1px solid var(--border-subtle);
  transition: background-color 0.15s ease;
}

.coursesTable tbody tr:hover {
  background-color: var(--bg-primary);
}

.coursesTable td {
  padding: 0.95rem 1rem;
  font-size: 0.87rem;
  color: var(--text-primary);
  vertical-align: middle;
}

.codeBadgeGroup {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.25rem;
}

.courseCodeBadge {
  font-family: monospace;
  font-size: 0.86rem;
  font-weight: 700;
  background-color: var(--bg-tertiary);
  color: var(--text-primary);
  padding: 0.15rem 0.5rem;
  border-radius: 6px;
  border: 1px solid var(--border-subtle);
}

.groupBadge {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.courseNameCell strong {
  font-weight: 700;
  color: var(--text-primary);
}

.departmentTag {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.25rem 0.65rem;
  border-radius: 999px;
  background-color: var(--bg-tertiary);
  color: var(--text-secondary);
}

.unitsBadge {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--accent-primary);
  background-color: var(--accent-soft);
  padding: 0.2rem 0.6rem;
  border-radius: 6px;
  white-space: nowrap;
}

.instructorsList {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.instructorName {
  font-size: 0.84rem;
  color: var(--text-secondary);
}

.sessionsCell {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.sessionPill {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem;
  font-size: 0.79rem;
  background-color: var(--bg-tertiary);
  padding: 0.25rem 0.6rem;
  border-radius: 6px;
  width: fit-content;
}

.sessionDay {
  font-weight: 700;
  color: var(--text-primary);
}

.sessionTime {
  color: var(--accent-primary);
  font-weight: 600;
}

.sessionLoc {
  color: var(--text-muted);
  font-size: 0.74rem;
}

.mutedText {
  color: var(--text-muted);
  font-size: 0.8rem;
}

.examCell {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  font-size: 0.82rem;
}

.examDate {
  font-weight: 600;
  color: var(--text-primary);
}

.examTime {
  font-size: 0.76rem;
  color: var(--text-muted);
}

.deleteRowBtn {
  padding: 0.4rem 0.8rem;
  border-radius: 6px;
  border: 1px solid var(--danger-border);
  background-color: var(--danger-bg);
  color: var(--danger-text);
  font-family: inherit;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
}

.deleteRowBtn:hover {
  background-color: var(--danger-primary);
  color: #ffffff;
}

/* Empty State Box */

.emptyStateBox {
  padding: 3.5rem 1.5rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.65rem;
}

.emptyStateIcon {
  font-size: 2.6rem;
}

.emptyStateTitle {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0;
}

.emptyStateText {
  font-size: 0.86rem;
  color: var(--text-muted);
  max-width: 480px;
  margin: 0 0 0.75rem 0;
}

.emptyStateCtaBtn,
.resetFilterBtn {
  padding: 0.65rem 1.2rem;
  border-radius: var(--radius-sm);
  border: none;
  background-color: var(--accent-primary);
  color: #ffffff;
  font-family: inherit;
  font-size: 0.86rem;
  font-weight: 600;
  cursor: pointer;
}

.emptyStateCtaBtn:hover,
.resetFilterBtn:hover {
  background-color: var(--accent-primary-hover);
}

/* ==========================================================================
   5. Confirmation Modal (Danger Zone Reset)
   ========================================================================== */

.modalBackdrop {
  position: fixed;
  inset: 0;
  z-index: 900;
  background-color: rgba(9, 13, 22, 0.72);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.25rem;
}

.modalCard {
  width: 100%;
  max-width: 480px;
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  padding: 1.75rem;
  box-shadow: var(--shadow-lg);
  animation: slideUp 0.2s ease-out;
}

.modalHeader {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.9rem;
}

.modalDangerIcon {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  background-color: var(--danger-bg);
  border: 1px solid var(--danger-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  flex-shrink: 0;
}

.modalTitle {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--text-primary);
  margin: 0;
}

.modalBodyText {
  font-size: 0.88rem;
  color: var(--text-secondary);
  line-height: 1.7;
  margin: 0 0 1.15rem 0;
}

.modalConfirmInputBox {
  background-color: var(--bg-primary);
  border: 1px solid var(--border-subtle);
  padding: 1rem;
  border-radius: var(--radius-sm);
  margin-bottom: 1.35rem;
}

.modalInputLabel {
  display: block;
  font-size: 0.82rem;
  color: var(--text-secondary);
  margin-bottom: 0.55rem;
}

.modalInputLabel code {
  color: var(--danger-primary);
  font-weight: 700;
  background-color: var(--danger-bg);
  padding: 0.1rem 0.4rem;
  border-radius: 4px;
}

.modalInput {
  width: 100%;
  padding: 0.65rem 0.85rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-strong);
  background-color: var(--bg-secondary);
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.9rem;
  outline: none;
  box-sizing: border-box;
}

.modalInput:focus {
  border-color: var(--danger-primary);
}

.modalActions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.75rem;
}

.modalCancelBtn {
  padding: 0.65rem 1.1rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-strong);
  background-color: var(--bg-tertiary);
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.86rem;
  font-weight: 600;
  cursor: pointer;
}

.modalConfirmDangerBtn {
  padding: 0.65rem 1.2rem;
  border-radius: var(--radius-sm);
  border: none;
  background-color: var(--danger-primary);
  color: #ffffff;
  font-family: inherit;
  font-size: 0.86rem;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.2s ease, background-color 0.2s ease;
}

.modalConfirmDangerBtn:hover:not(:disabled) {
  background-color: var(--danger-hover);
}

.modalConfirmDangerBtn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* ==========================================================================
   Responsive Breakpoints
   ========================================================================== */

@media (max-width: 1100px) {
  .metricsSection {
    grid-template-columns: repeat(2, 1fr);
  }

  .managementGrid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .headerInner {
    flex-direction: column;
    align-items: flex-start;
  }

  .headerActions {
    width: 100%;
    justify-content: flex-start;
  }

  .filtersRow {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 520px) {
  .metricsSection {
    grid-template-columns: 1fr;
  }

  .mainContainer {
    padding: 1.25rem 1rem 2.5rem;
  }

  .gatekeeperCard {
    padding: 1.75rem 1.25rem;
  }
}
</file>

